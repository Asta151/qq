function NumInput({ label, sub, value, onChange, min, max }) {
  return (
    <div>
      <div style={{ fontSize: 10, fontWeight: 800, letterSpacing: "0.08em", textTransform: "uppercase", color: C.textLight, marginBottom: 4 }}>
        {label}{sub && <span style={{ fontWeight: 400, marginLeft: 4, color: "#cbd5e1" }}>({sub})</span>}
      </div>
      <input type="number" value={value} min={min} max={max}
        onChange={e => onChange(e.target.value)}
        style={{ width: "100%", boxSizing: "border-box", padding: "9px 11px", borderRadius: 9, border: `1.5px solid ${C.border}`, fontSize: 15, fontWeight: 700, background: "#fafafa", outline: "none" }}
        onFocus={e => (e.target.style.border = `1.5px solid ${C.greenLight}`)}
        onBlur={e => (e.target.style.border = `1.5px solid ${C.border}`)} />
    </div>
  );
}

function SectionTitle({ children }) {
  return <div style={{ fontSize: 12, fontWeight: 800, letterSpacing: "0.08em", textTransform: "uppercase", color: C.textLight, margin: "20px 0 10px", display: "flex", alignItems: "center", gap: 8 }}>{children}</div>;
}

function ProgressRing({ pct, color, size = 64, stroke = 6 }) {
  const r = (size - stroke) / 2;
  const circ = 2 * Math.PI * r;
  return (
    <svg width={size} height={size} style={{ transform: "rotate(-90deg)" }}>
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke="#e2e8f0" strokeWidth={stroke} />
      <circle cx={size / 2} cy={size / 2} r={r} fill="none" stroke={color} strokeWidth={stroke}
        strokeDasharray={circ} strokeDashoffset={circ * (1 - Math.min(1, pct / 100))} strokeLinecap="round" style={{ transition: "stroke-dashoffset 0.5s" }} />
    </svg>
  );
}

