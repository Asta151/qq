// ── HELPERS ──────────────────────────────────────────────────────────────────
function calcBmr(weightKg, heightCm, age, sex) {
  return sex === "male"
    ? 10 * weightKg + 6.25 * heightCm - 5 * age + 5
    : 10 * weightKg + 6.25 * heightCm - 5 * age - 161;
}
function bmi(weightKg, heightCm) { return weightKg / ((heightCm / 100) ** 2); }
function bmiLabel(b) {
  if (b < 18.5) return ["Underweight", C.blue];
  if (b < 25) return ["Normal", C.green];
  if (b < 30) return ["Overweight", C.yellow];
  return ["Obese", C.red];
}
function water(weightKg) { return (weightKg * 35 / 1000).toFixed(1); }

