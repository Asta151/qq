function Pill({ active, onClick, children, color }) {
  const ac = color || C.green;
  return (
    <button onClick={onClick} style={{
      padding: "6px 13px", borderRadius: 100,
      border: `2px solid ${active ? ac : C.border}`,
      background: active ? ac + "18" : "#fff",
      color: active ? ac : C.textMid,
      fontWeight: active ? 700 : 500, fontSize: 13,
      cursor: "pointer", transition: "all 0.15s", whiteSpace: "nowrap",
    }}>{children}</button>
  );
}

function Card({ children, accent, style = {} }) {
  return (
    <div style={{
      background: accent ? C.greenBg : C.card,
      border: `1.5px solid ${accent ? C.greenBorder : C.border}`,
      borderRadius: 14, padding: "14px 16px", ...style
    }}>{children}</div>
  );
}

function Label({ children, style = {} }) {
  return <div style={{ fontSize: 10, fontWeight: 800, letterSpacing: "0.09em", textTransform: "uppercase", color: C.textLight, marginBottom: 6, ...style }}>{children}</div>;
}

function StatBox({ label, value, unit, sub, accent }) {
  return (
    <div style={{ background: accent ? C.greenBg : "#f8fafc", border: `1.5px solid ${accent ? C.greenBorder : C.border}`, borderRadius: 12, padding: "12px 14px" }}>
      <Label>{label}</Label>
      <div style={{ display: "flex", alignItems: "baseline", gap: 4 }}>
        <span style={{ fontSize: 24, fontWeight: 800, color: accent ? C.green : C.text, fontVariantNumeric: "tabular-nums" }}>{value}</span>
        {unit && <span style={{ fontSize: 11, color: C.textLight, fontWeight: 600 }}>{unit}</span>}
      </div>
      {sub && <div style={{ fontSize: 11, color: C.textLight, marginTop: 2 }}>{sub}</div>}
